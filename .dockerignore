scratch/
tests/
docs/
.reelforge/
AGENTS.md
README.md
WORKER_OPERATIONS.md
WORKER.env.example
.env.example

# OS / editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.zip
