# =============================================================================
# ReelForge V3.4 — WORKER ENVIRONMENT EXAMPLE
# =============================================================================
# Safe to commit: this file contains NO real credentials or secrets.
#
# A fresh worker must supply the REQUIRED variables below through the process
# environment (or a secrets manager). Values here are placeholders/defaults.
#
# Everything is read by config.py at import time. See WORKER_OPERATIONS.md for
# the full runtime contract (persistent vs ephemeral data, network, ports, etc).
#
# Do NOT copy .env, atlas-credentials.env, or token_cache.bin into a worker.

# ---------------------------------------------------------------------------
# REQUIRED — SECRETS (must be supplied at runtime, never committed)
# ---------------------------------------------------------------------------

# Telegram Bot API token (used by bot/telegram_bot.py).
TELEGRAM_BOT_TOKEN=

# Microsoft Azure app client ID for the public OAuth client + OneNote Graph API.
# Required even on a worker that only consumes per-user token caches from Mongo.
MICROSOFT_CLIENT_ID=

# MongoDB Atlas connection string (mongodb+srv://...). Effectively required in
# production: MongoDB is the authoritative persistent store. Also used by the
# optional Mongo connectivity check (python storage/db.py).
MONGODB_URI=

# ---------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION (non-secret routing knob)
# ---------------------------------------------------------------------------

# OpenAI-compatible gateway base URL. Worker contract: this MUST be externally
# reachable from the worker. Do NOT assume localhost in the cloud. The shown
# value is only the laptop-local default used when nothing is set.
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# ---------------------------------------------------------------------------
# OPTIONAL — SECRETS
# ---------------------------------------------------------------------------

# API key for the AI gateway. Empty = unauthenticated gateway.
OMNIROUTE_API_KEY=

# Random 32+ byte value used to sign OAuth state tokens.
# Only required on the device that runs the /connect loopback callback
# (laptop-side flow). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — NON-SECRET CONFIGURATION
# ---------------------------------------------------------------------------

# MongoDB database name (defaults to 'reelforge').
MONGODB_DB_NAME=reelforge

# AI gateway model names (defaults shown are the config.py fallbacks).
#   TEXT_MODEL  -> qwen2.5:7b-instruct
#   VISION_MODEL-> llama3.2-vision:latest
#   EVALUATION_MODEL -> falls back to TEXT_MODEL
TEXT_MODEL=
EVALUATION_MODEL=
VISION_MODEL=

# Max video frames sampled for vision analysis (default 8).
VISION_MAX_FRAMES=8

# Whisper transcription model (default 'base'). Overridden by WHISPER_MODEL if set.
WHISPER_MODEL=

# Whisper model cache directory. Empty => default user cache (~/.cache/whisper).
# Set this to a persistent volume on a worker to avoid re-downloading the model
# on every restart.
WHISPER_CACHE_DIR=

# V3.5 Layer 2 — embedded worker toggle (config.py default is ON).
#   1 (default)  : bot/telegram_bot.py starts an in-process worker task
#                  (single-process local development).
#   0 / false/no : bot runs WITHOUT processing; `python -m processing.worker`
#                  claims jobs from MongoDB `reel_jobs` instead.
REELFORGE_EMBEDDED_WORKER=

# FFmpeg binary directory. Empty => resolved from system PATH (required system
# package on Linux/cloud workers, e.g. `apt-get install -y ffmpeg`).
FFMPEG_PATH=

# --- Worker-local directories (all optional; defaults are repo-root-relative) --
# WORKSPACE_DIR: worker-local media scratch space. MUST be unique per worker and
#                safe to wipe (reel media is ephemeral). Absolute path, e.g.
#                /mnt/reelforge/worker-0/reels
WORKSPACE_DIR=

# BRAINS_DIR: local Brain JSON backup/fallback directory. NOTE: MongoDB remains
# primary ONLY while this path ends in '/brains' (config routing heuristic).
# Keep the default <ROOT>/brains on cloud workers.
BRAINS_DIR=

# PROMPTS_DIR: prompt template directory. Only set if prompts/ is not bundled
# alongside the code at <ROOT>/prompts.
PROMPTS_DIR=

# --- Microsoft / OAuth (laptop-side /connect flow; NOT needed on a worker) ----
# Included for parity with .env.example. A worker only CONSUMES per-user token
# caches already stored in MongoDB; it never serves the OAuth callback.
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
OAUTH_HOST=127.0.0.1
OAUTH_LISTEN_PORT=8080
OAUTH_BASE_URL=http://localhost:8080

# --- Compatibility fallbacks (OpenAI-style aliases; consumed by config.py) ----
# OMNIROUTE_BASE_URL falls back to OPENAI_BASE_URL, OMNIROUTE_API_KEY falls back
# to OPENAI_API_KEY. Optional; omit unless you standardize on OpenAI names.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# =============================================================================
# LEGACY / DO NOT USE ON A WORKER
#   - token_cache.bin          : legacy V2 global token file (GraphClient only
#                                uses it when user_id=None); V3 uses per-user
#                                token caches in MongoDB.
#   - sessions/ , MONGODB_USERNAME , MONGODB_PASSWORD : unused by current code.
#   - The repo .env / atlas-credentials.env files are excluded from the Docker
#     image; inject configuration via real environment variables instead.
# =============================================================================