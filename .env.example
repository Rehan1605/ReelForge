TELEGRAM_BOT_TOKEN=
MICROSOFT_CLIENT_ID=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
TEXT_MODEL=
EVALUATION_MODEL=
VISION_MODEL=
VISION_MAX_FRAMES=8
MONGODB_URI=
MONGODB_DB_NAME=reelforge

# --- Microsoft OAuth (ReelForge V3.3, per-user OneNote connections) ---
# Tenant for the OAuth authority URL. 'common' allows personal + work/school accounts.
MICROSOFT_TENANT_ID=common
# OAuth authority URL. Defaults to login.microsoftonline.com/<tenant>; only set
# this if you need a custom/national-cloud authority.
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
# Public callback URL for the OAuth redirect (must match the Azure app registration).
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
# REQUIRED — random 32+ byte string used to sign OAuth state tokens.
# Never hardcode; generate via: python -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=
# Local OAuth callback server binding.
OAUTH_HOST=127.0.0.1
OAUTH_LISTEN_PORT=8080
OAUTH_BASE_URL=http://localhost:8080
